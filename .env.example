# Same variable names snip36 uses, so one file serves both.
STARKNET_RPC_URL=<a Starknet mainnet JSON-RPC v0.10 endpoint that supports starknet_getStorageProof>
STARKNET_CHAIN_ID=SN_MAIN
# Filled by: npx tsx scripts/00-account.ts --new   (never paste your key anywhere else)
STARKNET_ACCOUNT_ADDRESS=
STARKNET_PRIVATE_KEY=

# STRK20 privacy pool (mainnet)
POOL=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a
# Filled after: npx tsx scripts/00-deploy-receipt.ts
RECEIPT_CONTRACT=
# Path to a built checkout of starkware-libs/starknet-privacy/sdk (npm ci && npm run build)
PRIVACY_SDK=
# Optional overrides
# PROVING_URL=https://cloud.argent-api.com/v1/privacy/proving
# DISCOVERY_URL=https://cloud.argent-api.com/v1/privacy/discovery
# PROVE_LAG=15
